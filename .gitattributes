# Keep source and tooling identical across Windows and CI checkouts.
* text=auto
*.lua text eol=lf
*.py text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.toc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
.gitattributes text eol=lf
.gitignore text eol=lf
.luacheckrc text eol=lf
.pkgmeta text eol=lf
*.png binary
